  "cards": [
    {
      "dot": "cyan",
      "title": "BaseController — shared foundation",
      "items": [
        "Loads Settings (.env) once in __init__",
        "Derives file_dir = src/assets/files",
        "generate_random_string() builds the 8-char random prefix"
      ]
    },
    {
      "dot": "emerald",
      "title": "DataController — validation & naming",
      "items": [
        "Inherits Settings, file_dir, random string from BaseController",
        "validate_uploaded_file(): MIME type + max-size checks",
        "generate_unique_filename(): regenerates until the filename is free on disk",
        "Delegates to ProjectController.get_project_path() for the target folder"
      ]
    },
    {
      "dot": "violet",
      "title": "ProjectController — storage layout",
      "items": [
        "Inherits file_dir from BaseController",
        "get_project_path(): joins file_dir with project_id",
        "Creates the project folder if missing, then returns its path"
      ]
    },
    {
      "dot": "amber",
      "title": "Upload path",
      "items": [
        "POST /api/v1/data/upload/{project_id} — project_id from the URL prefix",
        "Route orchestrates: validate, name, then write chunks with aiofiles",
        "Both routers inject the same Settings via Depends(get_settings)",
        "All responses return ResponseSignal enum text as {\"signal\": ...}"
      ]
    }
  ]
